# GB10/Spark compatible build based on:
# https://forums.developer.nvidia.com/t/building-llama-cpp-container-images-for-spark-gb10/353664/2
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

# Fix LD_LIBRARY_PATH for GB10 compatibility
ENV LD_LIBRARY_PATH=/usr/local/cuda-13/compat

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    cmake \
    python3 \
    python3-pip \
    libcurl4-openssl-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy llama.cpp from build context
# Note: LLAMA_CPP_PATH should be copied into ./llama.cpp before building
COPY llama.cpp /app/llama.cpp

# Build llama.cpp for GB10 (CUDA arch 121)
RUN cd /app/llama.cpp && \
    if [ -f build/bin/llama-server ]; then \
        echo "Using pre-built llama-server"; \
        cp build/bin/llama-server /llama-server; \
    else \
        echo "Building llama.cpp for GB10..."; \
        mkdir -p build && \
        cd build && \
        cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DGGML_CUDA=ON \
            -DLLAMA_CURL=ON \
            -DCMAKE_CUDA_ARCHITECTURES=121 && \
        cmake --build . --config Release -j$(nproc) && \
        cp bin/llama-server /llama-server; \
    fi

# Create logs directory
RUN mkdir -p /logs

# Default command
CMD ["/bin/bash", "-c", "/llama-server --host 0.0.0.0 --port 8001 --ctx-size 16384 --threads 8 --n-gpu-layers 99 --model ${MODEL_PATH} --mmproj ${MM_PROJ_PATH}"]
