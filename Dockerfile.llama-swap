# Build llama-swap for arm64/GB10
FROM golang:1.25.7-bookworm AS builder

WORKDIR /build

# Install Node.js for UI build
RUN apt-get update && apt-get install -y nodejs npm && rm -rf /var/lib/apt/lists/*

# Copy llama-swap from build context (cloned by deploy script)
COPY llama-swap /build

# Build the UI first (outputs directly to proxy/ui_dist per vite.config.ts)
WORKDIR /build/ui-svelte
RUN npm install && npm run build

# Verify UI was built
WORKDIR /build
RUN ls -la proxy/ui_dist/ | head -10 || echo "UI dist directory check"

# Download Go dependencies
WORKDIR /build
RUN GOTOOLCHAIN=auto go mod download

# Build for linux/arm64
RUN GOTOOLCHAIN=auto CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o llama-swap .

# Final stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Copy binary from builder
COPY --from=builder /build/llama-swap /app/llama-swap

# Make executable
RUN chmod +x /app/llama-swap

# Expose port
EXPOSE 8080

# Run llama-swap with config file
CMD ["/app/llama-swap", "-config", "/app/config.yaml"]
